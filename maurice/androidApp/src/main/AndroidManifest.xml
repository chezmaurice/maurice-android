<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation: recorded, then sent whole to the household's Whisper. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Scanning an invitation's QR code. Not required: tablets without a camera install too. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Notifications (Android 13+ asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MauriceApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- maurice://conversations/<id>: Carnet hands a conversation over. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maurice" android:host="conversations" />
            </intent-filter>
            <!-- An invitation, tapped: https://<foyer>.chezmaurice.eu/join?code=…, verified
                 against https://chezmaurice.eu/.well-known/assetlinks.json (a wildcard host is
                 checked on its parent). A self-hosted household's link opens its /join page,
                 whose "Open" button uses maurice://join. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="*.chezmaurice.eu" />
                <data android:path="/join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maurice" android:host="join" />
            </intent-filter>
            <!-- maurice://signup?code=…: the "Open in Maurice" button of the hosting
                 service's page for an access code, which makes a Maurice. (Its own
                 https link, account.chezmaurice.eu/?code=…, is not declared: it
                 would take an assetlinks entry on the tower first.) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maurice" android:host="signup" />
            </intent-filter>
            <!-- "Share to Maurice": a page, some text, photos. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- UnifiedPush: the distributor (ntfy) talks to the app through this service. -->
        <service
            android:name=".MauricePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
