{
  "domain": "session-address",
  "about": "A household address typed by the member, made into the base URL the app pairs with — or refused.",
  "ios": "Maurice/Views/PairingView.swift — PairingView.normalizedURL",
  "android": "core/session/Invitation.kt — normalizeServerUrl",
  "cases": [
    { "name": "bare host", "input": "maison.example" },
    { "name": "https", "input": "https://maison.example" },
    { "name": "http with port", "input": "http://192.168.1.10:3000" },
    { "name": "spaces and trailing slash", "input": "  maison.example/  " },
    { "name": "several trailing slashes", "input": "maison.example///" },
    { "name": "uppercase scheme", "input": "HTTPS://Maison.Example" },
    { "name": "mixed-case http scheme", "input": "Http://maison.example" },
    { "name": "empty", "input": "" },
    { "name": "spaces only", "input": "   " },
    { "name": "newline only", "input": "\n" },
    { "name": "scheme only", "input": "https://" },
    { "name": "http scheme only", "input": "http://" },
    { "name": "slash", "input": "/" },
    { "name": "localhost", "input": "localhost" },
    { "name": "localhost with port", "input": "localhost:3000" },
    { "name": "IPv4", "input": "192.168.1.10" },
    { "name": "with a path", "input": "maison.example/garden" },
    { "name": "https with path and slash", "input": "https://maison.example/garden/" },
    { "name": "space inside", "input": "maison example" },
    { "name": "query", "input": "maison.example?x=1" },
    { "name": "fragment", "input": "maison.example#top" },
    { "name": "ftp scheme", "input": "ftp://maison.example" },
    { "name": "user in front", "input": "alice@maison.example" },
    { "name": "IPv6 with port", "input": "[::1]:3000" },
    { "name": "https IPv6", "input": "https://[::1]:3000" },
    { "name": "IDN", "input": "münchen.example" },
    { "name": "letters as port", "input": "maison.example:abc" },
    { "name": "port alone", "input": ":3000" },
    { "name": "port out of range", "input": "https://maison.example:99999" },
    { "name": "pasted app link", "input": "maurice://join?server=maison.example&code=ABCD1234" },
    { "name": "pasted QR link", "input": "https://maison.example/join?code=ABCD1234" },
    { "name": "tab inside", "input": "maison.\texample" },
    { "name": "emoji host", "input": "🏠.example" }
  ]
}
