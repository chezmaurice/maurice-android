{
 "domain": "composer-spec",
 "about": "A saved context item (a conversation's spec, a domain's baked-in context) read back into the tray, and what the tray sends for it (the payload of /weigh and of the saved spec).",
 "ios": "Maurice/Services/ComposerStore.swift — ComposerStore.itemFromSpec, TrayItem.payload()",
 "android": "core/composer/TrayItem.kt — TrayItem.fromSpec, TrayItem.payload()",
 "cases": [
  {
   "name": "note, full options",
   "input": {
    "type": "note",
    "id": "jardin/potager",
    "recurse": true,
    "include_archived": true,
    "exclude": [
     "a",
     "b"
    ],
    "snapshot": {
     "encrypted": true,
     "weight": 900,
     "count": 3
    }
   }
  },
  {
   "name": "note, bare",
   "input": {
    "type": "note",
    "id": "santé-été"
   }
  },
  {
   "name": "note, exclude with a number",
   "accepted": {
    "kind": "lenient",
    "why": "Android keeps the readable entries of `exclude` (a number as its string, null left out); iOS drops the whole list for one entry that is not a string."
   },
   "input": {
    "type": "note",
    "id": "n",
    "exclude": [
     1,
     "a",
     null
    ]
   }
  },
  {
   "name": "note, recurse as a string",
   "accepted": {
    "kind": "lenient",
    "why": "Android reads \"true\" as true; iOS takes only a boolean (1 and 0 now read alike on both sides)."
   },
   "input": {
    "type": "note",
    "id": "n",
    "recurse": "true",
    "include_archived": 1
   }
  },
  {
   "name": "book, numeric id, all",
   "input": {
    "type": "book",
    "id": 42,
    "representation": "full",
    "scope": {
     "mode": "all"
    }
   }
  },
  {
   "name": "book, id as a string",
   "input": {
    "type": "book",
    "id": "42",
    "scope": {
     "mode": "all"
    }
   }
  },
