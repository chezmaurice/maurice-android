     "mode": "up_to",
     "chapter": 6
    }
   }
  },
  {
   "name": "book, up to, chapter as a string",
   "accepted": {
    "kind": "lenient",
    "why": "Android reads the chapter \"6\" as 6; iOS takes only a number and falls back to 0."
   },
   "input": {
    "type": "book",
    "id": 7,
    "scope": {
     "mode": "up_to",
     "chapter": "6"
    }
   }
  },
  {
