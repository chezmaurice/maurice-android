{
 "domain": "domains-binding",
 "about": "Filing a conversation under one of the member's domains, or taking it out (the pastille menu, the brief page): what is sent, whether it took, and what the list then says of the conversation.",
 "ios": "Maurice/Services/ChatService.swift — setDomain(_:forConversation:)",
 "android": "core/chat/ChatController.kt — setDomain(mauriceId, conversationId)",
 "cases": [
  {
   "name": "bind to a domain",
   "input": {
    "conversation": "c2",
    "domain": "d1"
   },
   "routes": [
    {
     "method": "GET",
     "path": "/api/conversations",
     "json": [
      {
       "id": "c1",
       "title": "Course",
       "created_at": "2026-11-01 09:00:00",
       "updated_at": "2026-11-10 09:00:00",
       "maurice_id": "d1",
       "maurice_bound_by": "auto"
      },
      {
       "id": "c2",
       "title": "Autre",
       "created_at": "2026-11-01 09:00:00",
       "updated_at": "2026-11-09 09:00:00"
      }
     ]
    },
    {
     "method": "GET",
     "path": "/api/domains/proposals",
     "json": {
      "total_conversations": 0,
      "proposals": [],
      "settled": [],
      "unseen": 0
     }
    },
    {
     "method": "PATCH",
     "path": "/api/conversations/c2/maurice",
     "json": {
      "ok": true
     }
    }
   ]
  },
