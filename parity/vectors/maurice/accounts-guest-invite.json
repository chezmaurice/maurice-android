      },
      "routes": [
        {
          "method": "POST",
          "path": "/api/me/guest-invite",
          "json": {
            "code": "AB12CD34",
            "expires_at": "2026-11-18T10:00:00Z"
          }
        }
      ]
    },
    {
      "name": "500 with the server's words: failed, the row stays",
      "input": {
        "member": "g9"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/api/me/guest-invite",
          "status": 500,
          "json": {
            "error": "Database is locked"
          }
        }
      ]
    },
    {
      "name": "429: failed, the row stays",
      "input": {
        "member": "g10"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/api/me/guest-invite",
          "status": 429,
          "json": {
            "error": "Too many invitations"
          }
        }
      ]
    },
    {
      "name": "an answer without expires_at",
      "input": {
        "member": "g11"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/api/me/guest-invite",
          "json": {
            "code": "AB12CD34"
          }
        }
      ],
      "accepted": {
        "kind": "platform",
        "why": "An unreadable answer: iOS shows Foundation's decoding sentence, Android the serialization library's; both keep the row and show no code."
      }
    },
