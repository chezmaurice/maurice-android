        "eu.chezmaurice.maurice.topup.10",
        "eu.chezmaurice.maurice.topup.20"
       ]
      }
     }
    ]
   },
   "accepted": { "kind": "platform", "why": "Android sells through Play Billing (parity.md: StoreKit vs Play): `?store=google` asks the tower for Play's catalogue; without it the tower answers as to the iOS app." }
