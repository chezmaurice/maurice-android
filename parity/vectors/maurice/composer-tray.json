{
 "domain": "composer-tray",
 "about": "The context tray of a conversation: its saved spec read back and weighed, what adding, toggling, removing and changing an item sends (weigh, then save), what the weighing says on the cards and the totals, a blank page's tray, a followed book's reading controls, the picker's search, the note/folder previews and a book's chapters.",
 "ios": "Maurice/Services/ComposerStore.swift — setConversation, carryTo, add, toggle, remove, update, reweigh, save, setReadingPaused, resetReadingProgress, search, resolveNote, resolveFolder, bookChapters",
 "android": "core/composer/ComposerStore.kt (+ ComposerApi.kt) — bind, carryTo, add, toggle, remove, update, setReadingPaused, resetReadingProgress, search, resolveNote, resolveFolder, bookChapters",
 "cases": [
  {
   "name": "bind: the saved spec, weighed",
   "input": {
    "steps": [
     {
      "bind": "c1",
      "locked": {
       "name": "Santé",
       "count": 2,
       "weight": 3000
      }
     }
    ]
   },
   "routes": [
    {
     "method": "GET",
     "path": "/api/v1/composer/context/c1",
     "json": {
      "items": [
       {
        "type": "note",
        "id": "n1",
        "recurse": true,
        "exclude": [
         "n1/a"
        ],
        "snapshot": {
         "weight": 800
        }
       },
       {
        "type": "book",
        "id": 42,
        "representation": "summary",
        "scope": {
         "mode": "progress"
        },
        "snapshot": {
         "progressChapter": 2
        }
       },
       {
        "type": "conversation",
        "id": "c9"
       }
      ]
     }
    },
    {
     "method": "POST",
     "path": "/api/v1/composer/weigh",
     "json": {
      "total": 5000,
      "tier": "light",
      "over": false,
      "items": [
       {
        "weight": 1000,
        "count": 3,
        "title": "Potager",
        "moc": true,
        "heavy": false
       },
       {
        "weight": 3000,
        "visibleCount": 20,
        "progressChapter": 5,
        "progressPaused": true,
        "title": "Dune"
       },
       {
        "weight": 1000,
        "summarisable": true,
        "summary": "ready",
        "fullWeight": 9000,
        "uncovered": 2,
        "title": "Recettes"
       }
      ]
     }
    }
   ]
  },
