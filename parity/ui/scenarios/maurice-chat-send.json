  "steps": [
    {"tap": "Enter a code or an address"},
    {"tap": "XXXX-XXXX or martin.chezmaurice.eu"},
    {"type": "{base}"},
    {"tap": "Connect", "pause": 3},
    {"see": "Who's here?"},
    {"tap": "Other options"},
    {"tap": "Sign in as admin"},
    {"tap": "Username"},
    {"type": "alice"},
    {"tap": "Password"},
    {"type": "correct-horse"},
    {"tap": "Sign in", "pause": 4},
    {"only": "ios", "tap": "Back to conversations", "pause": 2, "expect": "New conversation"},
    {"tap": "Recettes", "pause": 3},
    {"see": "Bonjour !"},
    {"tap": "Ask Maurice something..."},
    {"type": "Une soupe ?"},
    {"tap": {"ios": "Up", "android": "Send to Maurice"}, "pause": 4},
    {"checkpoint": "answered", "paths": ["/api/conversations/c1/messages"]}
  ]
}
