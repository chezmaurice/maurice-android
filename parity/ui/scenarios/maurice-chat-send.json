{
  "name": "maurice-chat-send",
  "app": "maurice",
  "about": "A conversation opened from the list, a message typed and sent: the reply streams back (thinking, two text pieces, done) and is shown.",
  "routes": [
    {"method": "GET", "path": "/api/suggestions", "json": {"suggestions": [], "pending": 0, "kept": 0}},
    {"method": "POST", "path": "/api/conversations/c1/messages", "ndjson": [{"type": "thinking"}, {"type": "text_delta", "text": "Un potage "}, {"type": "text_delta", "text": "aux poireaux."}, {"type": "done", "message_id": "m4"}]},
    {"method": "GET", "path": "/api/conversations", "json": [{"id": "c1", "title": "Recettes", "maurice_id": null, "created_at": "2026-11-01 09:00:00", "updated_at": "2026-11-10 18:30:00"}]},
    {"method": "GET", "path": "/api/conversations/c1/turn", "status": 204},
    {"method": "POST", "path": "/api/conversations/c1/read", "json": {"ok": true}},
    {"method": "GET", "path": "/api/conversations/c1", "json": {"id": "c1", "title": "Recettes", "maurice_id": null, "created_at": "2026-11-01 09:00:00", "updated_at": "2026-11-10 18:30:00", "messages": [{"id": "m1", "role": "user", "content": "Salut", "author_id": "u1", "created_at": "2026-11-10 18:00:00"}, {"id": "m2", "role": "assistant", "content": "Bonjour !", "created_at": "2026-11-10 18:00:05"}], "participants": [{"member_id": "u1", "role": "owner", "display_name": "Alice", "avatar_color": "#c0392b"}]}},
    {"method": "GET", "path": "/api/conversations/c1", "json": {"id": "c1", "title": "Recettes", "maurice_id": null, "created_at": "2026-11-01 09:00:00", "updated_at": "2026-11-10 18:30:00", "messages": [{"id": "m1", "role": "user", "content": "Salut", "author_id": "u1", "created_at": "2026-11-10 18:00:00"}, {"id": "m2", "role": "assistant", "content": "Bonjour !", "created_at": "2026-11-10 18:00:05"}, {"id": "m3", "role": "user", "content": "Une soupe ?", "author_id": "u1", "created_at": "2026-11-11 10:00:00"}, {"id": "m4", "role": "assistant", "content": "Un potage aux poireaux.", "created_at": "2026-11-11 10:00:05"}], "participants": [{"member_id": "u1", "role": "owner", "display_name": "Alice", "avatar_color": "#c0392b"}]}},
    {"method": "GET", "path": "/api/health", "json": {"status": "ok", "version": "1.0.0", "setup_complete": true, "household": "Les Tilleuls", "household_color": "#4a7c59", "household_icon": "leaf"}},
    {"method": "POST", "path": "/api/auth/login", "json": {"user_id": "u1", "token": "tok-u1"}, "times": 1},
    {"method": "GET", "path": "/api/users", "json": [{"id": "u1", "display_name": "Alice", "avatar_color": "#c0392b", "has_pin": true, "role": "admin", "username": "alice"}, {"id": "u2", "display_name": "Bruno", "avatar_color": "#2980b9", "has_pin": true, "role": "standard"}]},
    {"method": "GET", "path": "/api/users/me", "json": {"id": "u1", "display_name": "Alice", "avatar_color": "#c0392b", "has_pin": true, "role": "admin", "username": "alice"}},
    {"method": "GET", "path": "/api/me/events", "json": {"events": []}},
    {"method": "GET", "path": "/api/maurices", "json": []},
    {"method": "GET", "path": "/api/domains", "json": {"domains": [], "companions": []}},
    {"method": "GET", "path": "/api/me/budget", "json": {}},
    {"method": "GET", "path": "/api/conversations", "json": []},
    {"method": "GET", "path": "/api/me/ai-consent", "json": {"needs_answer": false, "uncovered": [], "record": {"status": "accepted", "providers": ["scaleway"], "decided_at": "2026-10-29 17:23:50"}, "providers": [{"id": "scaleway", "name": "Scaleway Generative APIs", "region": "FR", "city": "Paris"}]}},
    {"method": "GET", "path": "/api/users/me/preferences", "json": {}},
    {"method": "GET", "path": "/api/models/everyday", "json": {"id": null}},
    {"method": "GET", "path": "/api/models", "json": []},
    {"method": "GET", "path": "/api/tool-families", "json": []},
    {"method": "GET", "path": "/api/users/me/unread", "json": {"unread": 0}},
