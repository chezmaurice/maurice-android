{
  "name": "carnet-shelf-refused",
  "app": "carnet",
  "about": "The shelf read refused (500): what the member is told.",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/garden/entries",
      "query": {
        "view": "shelf"
      },
      "status": 500,
      "json": {
        "error": "garden unavailable"
      }
    }
  ],
  "households": [
    "carnet-household"
  ],
  "steps": [
    {
      "include": "carnet-sign-in"
    },
    {
      "wait": 3
    },
    {
      "checkpoint": "refused"
    }
  ]
}