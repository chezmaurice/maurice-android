{
  "name": "maurice-settings-admin-password",
  "app": "maurice",
  "about": "Settings → Administrator password: a new password too short is refused before anything is sent; the server refuses one too easy to guess (400 password_weak), then a wrong current password (401 password_wrong).",
  "routes": [
    {"method": "POST", "path": "/api/auth/password", "status": 400, "json": {"error": "The new password must be too easy to guess", "code": "password_weak", "min": 12}, "times": 1},
    {"method": "POST", "path": "/api/auth/password", "status": 401, "json": {"error": "The current password is not right", "code": "password_wrong"}},
    {"method": "GET", "path": "/api/health", "json": {"status": "ok", "version": "1.0.0", "setup_complete": true, "household": "Les Tilleuls", "household_color": "#4a7c59", "household_icon": "leaf"}},
    {"method": "POST", "path": "/api/auth/login", "json": {"user_id": "u1", "token": "tok-u1"}, "times": 1},
    {"method": "GET", "path": "/api/users", "json": [{"id": "u1", "display_name": "Alice", "avatar_color": "#c0392b", "has_pin": true, "role": "admin", "username": "alice"}, {"id": "u2", "display_name": "Bruno", "avatar_color": "#2980b9", "has_pin": true, "role": "standard"}]},
    {"method": "GET", "path": "/api/users/me", "json": {"id": "u1", "display_name": "Alice", "avatar_color": "#c0392b", "has_pin": true, "role": "admin", "username": "alice"}},
    {"method": "GET", "path": "/api/me/events", "json": {"events": []}},
    {"method": "GET", "path": "/api/maurices", "json": []},
    {"method": "GET", "path": "/api/domains", "json": {"domains": [], "companions": []}},
    {"method": "GET", "path": "/api/me/budget", "json": {}},
    {"method": "GET", "path": "/api/conversations", "json": []},
    {"method": "GET", "path": "/api/me/ai-consent", "json": {"needs_answer": false, "uncovered": [], "record": {"status": "accepted", "providers": ["scaleway"], "decided_at": "2026-10-29 17:23:50"}, "providers": [{"id": "scaleway", "name": "Scaleway Generative APIs", "region": "FR", "city": "Paris"}]}},
    {"method": "GET", "path": "/api/users/me/preferences", "json": {}},
    {"method": "GET", "path": "/api/models/everyday", "json": {"id": null}},
    {"method": "GET", "path": "/api/models", "json": []},
    {"method": "GET", "path": "/api/tool-families", "json": []},
    {"method": "GET", "path": "/api/users/me/unread", "json": {"unread": 0}},
    {"method": "GET", "path": "/api/domains/proposals", "json": {"proposals": []}},
    {"method": "PATCH", "path": "/api/users/me/preferences", "json": {}},
    {"method": "POST", "path": "/api/users/me/device", "json": {"ok": true}}
  ],
  "steps": [
    {"tap": "Enter a code or an address"},
    {"tap": "XXXX-XXXX or martin.chezmaurice.eu"},
    {"type": "{base}"},
    {"tap": "Connect", "pause": 3},
    {"see": "Who's here?"},
    {"tap": "Other options"},
    {"tap": "Sign in as admin"},
    {"tap": "Username"},
    {"type": "alice"},
    {"tap": "Password"},
    {"type": "correct-horse"},
    {"tap": "Sign in", "pause": 4},
    {"only": "ios", "tap": "Back to conversations", "pause": 2, "expect": "New conversation"},
    {"tap": {"ios": "A, Alice", "android": "Settings"}, "pause": 2, "expect": "Sign out"},
    {"tap": "Administrator password", "pause": 2},
    {"tap": "Current password"},
    {"type": "correct-horse"},
    {"tap": "New password"},
    {"type": "short"},
    {"tap": "New password, again"},
    {"type": "short"},
    {"scrollto": "Change the password", "within": {"android": 0.6}},
    {"tap": "Change the password", "pause": 2},
    {"checkpoint": "too short", "paths": ["/api/auth/password"]},
    {"clear": true},
    {"type": "password password"},
    {"tap": "•••••"},
    {"clear": true},
    {"type": "password password"},
    {"scrollto": "Change the password", "within": {"android": 0.6}},
    {"tap": "Change the password", "pause": 2},
    {"checkpoint": "too easy", "paths": ["/api/auth/password"]},
    {"scrollto": "Change the password", "within": {"android": 0.6}},
    {"tap": "Change the password", "pause": 3},
    {"checkpoint": "wrong current", "paths": ["/api/auth/*", "/api/users"]}
  ]
}
