{
  "name": "maurice-join-with-code",
  "app": "maurice",
  "about": "A blank device joins with an invitation code typed alone: the address is asked next, the open invitation asks who is joining (name, colour), then a PIN must be set — a too-easy one and a mismatch are refused before anything is sent — and the newcomer is in.",
  "routes": [
    {"method": "GET", "path": "/api/health", "json": {"status": "ok", "version": "1.0.0", "setup_complete": true, "household": "Les Tilleuls", "household_color": "#4a7c59", "household_icon": "leaf"}},
    {"method": "POST", "path": "/api/auth/enroll", "json": {"needs_profile": true}, "times": 1},
    {"method": "POST", "path": "/api/auth/enroll", "json": {"user_id": "u3", "token": "tok-u3", "needs_pin": true}},
    {"method": "GET", "path": "/api/users/me", "json": {"id": "u3", "display_name": "Chloe", "avatar_color": "#3d6b4f", "has_pin": false, "role": "standard"}},
    {"method": "POST", "path": "/api/auth/set-pin", "json": {"ok": true}},
    {"method": "GET", "path": "/api/users", "json": [{"id": "u1", "display_name": "Alice", "avatar_color": "#c0392b", "has_pin": true, "role": "admin", "username": "alice"}, {"id": "u3", "display_name": "Chloe", "avatar_color": "#3d6b4f", "has_pin": true, "role": "standard"}]},
    {"method": "GET", "path": "/api/me/events", "json": {"events": []}},
    {"method": "GET", "path": "/api/maurices", "json": []},
    {"method": "GET", "path": "/api/domains", "json": {"domains": [], "companions": []}},
    {"method": "GET", "path": "/api/me/budget", "json": {}},
    {"method": "GET", "path": "/api/conversations", "json": []},
    {"method": "GET", "path": "/api/me/ai-consent", "json": {"needs_answer": false, "uncovered": [], "record": {"status": "accepted", "providers": ["scaleway"], "decided_at": "2026-10-29 17:23:50"}, "providers": [{"id": "scaleway", "name": "Scaleway Generative APIs", "region": "FR", "city": "Paris"}]}},
    {"method": "GET", "path": "/api/users/me/preferences", "json": {}},
    {"method": "GET", "path": "/api/models/everyday", "json": {"id": null}},
    {"method": "GET", "path": "/api/models", "json": []},
    {"method": "GET", "path": "/api/tool-families", "json": []},
    {"method": "GET", "path": "/api/users/me/unread", "json": {"unread": 0}},
    {"method": "GET", "path": "/api/domains/proposals", "json": {"proposals": []}},
    {"method": "PATCH", "path": "/api/users/me/preferences", "json": {}},
    {"method": "POST", "path": "/api/users/me/device", "json": {"ok": true}}
  ],
  "steps": [
    {"tap": "Enter a code or an address"},
    {"tap": "XXXX-XXXX or martin.chezmaurice.eu"},
    {"type": "abcd-2345"},
    {"tap": "Connect"},
    {"tap": "monfoyer.chezmaurice.eu"},
    {"type": "{base}"},
    {"tap": "Connect", "pause": 3},
    {"see": "Who's joining?"},
    {"checkpoint": "who is joining", "accepted": {"kind": "wire", "why": "iOS checks /api/health a second time when the code's invitation is received (SessionStore.receive), right after the check that read the address; Android checks once. Same answer, nothing the member sees."}},
    {"tapxy": {"ios": [155, 598], "android": [490, 1288]}},
    {"tap": "Your first name"},
    {"type": "Chloe"},
    {"tap": "Continue", "pause": 3},
    {"see": "Set a PIN"},
    {"checkpoint": "set a PIN"},
    {"tap": "PIN"},
    {"type": "1234"},
    {"tap": "Confirm PIN"},
    {"type": "1234"},
    {"tap": "Set PIN"},
    {"checkpoint": "too easy"},
    {"clear": true},
    {"tap": "••••"},
    {"clear": true},
    {"type": "1357"},
    {"tap": "Confirm PIN"},
    {"type": "1358"},
    {"tap": "Set PIN"},
    {"checkpoint": "mismatch"},
    {"clear": true},
    {"type": "1357"},
    {"tap": "Set PIN", "pause": 4},
    {"checkpoint": "in", "paths": ["/api/auth/*"]}
  ]
}
