{
  "name": "maurice-settings-member-sheet",
  "app": "maurice",
  "about": "Settings → Members → a member: their sheet; the name is changed and saved, then the member is deleted after a confirmation.",
  "routes": [
    {
      "method": "GET",
      "path": "/api/users/invites",
      "json": {
        "invites": []
      }
    },
    {
      "method": "PATCH",
      "path": "/api/users/u2",
      "json": {
        "id": "u2",
        "display_name": "Bruno B",
        "avatar_color": "#2980b9",
        "has_pin": true,
        "role": "standard"
      }
    },
    {
      "method": "DELETE",
      "path": "/api/users/u2",
      "status": 204
    },
    {
      "method": "GET",
      "path": "/api/health",
      "json": {
        "status": "ok",
        "version": "1.0.0",
        "setup_complete": true,
        "household": "Les Tilleuls",
        "household_color": "#4a7c59",
        "household_icon": "leaf"
      }
    },
    {
      "method": "POST",
      "path": "/api/auth/login",
      "json": {
        "user_id": "u1",
        "token": "tok-u1"
      },
      "times": 1
    },
    {
      "method": "GET",
      "path": "/api/users",
      "json": [
        {
          "id": "u1",
          "display_name": "Alice",
          "avatar_color": "#c0392b",
          "has_pin": true,
          "role": "admin",
          "username": "alice"
        },
        {
          "id": "u2",
          "display_name": "Bruno",
          "avatar_color": "#2980b9",
          "has_pin": true,
          "role": "standard"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/users/me",
      "json": {
        "id": "u1",
        "display_name": "Alice",
        "avatar_color": "#c0392b",
        "has_pin": true,
        "role": "admin",
        "username": "alice"
      }
    },
    {
      "method": "GET",
      "path": "/api/me/events",
      "json": {
        "events": []
      }
    },
    {
      "method": "GET",
      "path": "/api/maurices",
      "json": []
    },
    {
      "method": "GET",
      "path": "/api/domains",
      "json": {
        "domains": [],
        "companions": []
      }
    },
    {
      "method": "GET",
      "path": "/api/me/budget",
      "json": {}
    },
    {
      "method": "GET",
      "path": "/api/conversations",
      "json": []
    },
    {
      "method": "GET",
      "path": "/api/me/ai-consent",
      "json": {
        "needs_answer": false,
        "uncovered": [],
        "record": {
          "status": "accepted",
          "providers": [
            "scaleway"
          ],
          "decided_at": "2026-10-29 17:23:50"
        },
        "providers": [
          {
            "id": "scaleway",
            "name": "Scaleway Generative APIs",
            "region": "FR",
            "city": "Paris"
          }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/api/users/me/preferences",
      "json": {}
    },
    {
      "method": "GET",
      "path": "/api/models/everyday",
      "json": {
        "id": null
      }
    },
    {
      "method": "GET",
      "path": "/api/models",
      "json": []
    },
    {
      "method": "GET",
      "path": "/api/tool-families",
      "json": []
    },
    {
      "method": "GET",
      "path": "/api/users/me/unread",
      "json": {
        "unread": 0
      }
    },
    {
      "method": "GET",
      "path": "/api/domains/proposals",
      "json": {
        "proposals": []
      }
    },
    {
      "method": "PATCH",
      "path": "/api/users/me/preferences",
      "json": {}
    },
    {
      "method": "POST",
      "path": "/api/users/me/device",
      "json": {
        "ok": true
      }
    }
  ],
  "steps": [
    {
      "tap": "Enter a code or an address"
    },
    {
      "tap": "XXXX-XXXX or martin.chezmaurice.eu"
    },
    {
      "type": "{base}"
    },
    {
      "tap": "Connect",
      "pause": 3
    },
    {
      "see": "Who's here?"
    },
    {
      "tap": "Other options"
    },
    {
      "tap": "Sign in as admin"
    },
    {
      "tap": "Username"
    },
    {
      "type": "alice"
    },
    {
      "tap": "Password"
    },
    {
      "type": "correct-horse"
    },
    {
      "tap": "Sign in",
      "pause": 4
    },
    {
      "only": "ios",
      "tap": "Back to conversations",
      "pause": 2,
      "expect": "New conversation"
    },
    {
      "tap": {
        "ios": "A, Alice",
        "android": "Settings"
      },
      "pause": 2,
      "expect": "Sign out"
    },
    {
      "tap": "Members",
      "pause": 2
    },
    {
      "tap": "Bruno",
      "pause": 2
    },
    {
      "checkpoint": "sheet",
      "paths": [
        "/api/users/u2*"
      ]
    },
    {
      "tap": "Bruno",
      "nth": {
        "ios": 3,
        "android": 1
      }
    },
    {
      "clear": true
    },
    {
      "type": "Bruno B"
    },
    {
      "tap": "Save",
      "pause": 2
    },
    {
      "checkpoint": "renamed",
      "paths": [
        "/api/users/u2*"
      ]
    },
    {
      "tap": "Bruno B",
      "pause": 2
    },
    {
      "tap": "Delete this member"
    },
    {
      "checkpoint": "asked",
      "paths": [
        "/api/users/u2*"
      ]
    },
    {
      "tap": "Delete this member",
      "nth": {
        "ios": 2,
        "android": 1
      },
      "pause": 2
    },
    {
      "checkpoint": "deleted",
      "paths": [
        "/api/users/u2*"
      ]
    }
  ]
}
