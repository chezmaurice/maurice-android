<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scanning an invitation's QR code. Not required: tablets without a camera install too. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Dictation: recorded, then sent whole to the household's Whisper. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The conversations Maurice opens, the entries another member shares (UnifiedPush). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Is the Maurice app here, to hand a conversation over to it? -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="maurice" />
        </intent>
    </queries>

    <application
        android:name=".CarnetApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- carnet://entry/<collection>/<locale>/<slug>, from the Maurice app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carnet" android:host="entry" />
            </intent-filter>
            <!-- An invitation, tapped: the same link as for Maurice, https://<foyer>.chezmaurice.eu/join?code=…
                 (verified against https://chezmaurice.eu/.well-known/assetlinks.json), or carnet://join from
                 a self-hosted household's /join page. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="*.chezmaurice.eu" />
                <data android:path="/join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="carnet" android:host="join" />
            </intent-filter>
            <!-- A page shared from a browser or any app: Save to Carnet. -->
            <intent-filter android:label="Save to Carnet">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- An EPUB or a PDF shared from a files app or a browser: to the household's library. -->
            <intent-filter android:label="Save to Carnet">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <!-- An entry's card (an image), lent to the app it is shared with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/card_paths" />
        </provider>
        <!-- UnifiedPush: the distributor (ntfy) talks to the app through this service.
             Its own registration, apart from the Maurice app's. -->
        <service
            android:name=".CarnetPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
